{
  "name": "@void/pstack",
  "version": "0.1.0",
  "description": "pstack 移植：55 个技能 + poteto-mode 常驻段 + poteto-agent / comment-sicko 两个子代理",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skills-index": {
      "types": "./lib/skills/index.d.ts",
      "default": "./lib/skills/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "prompts/",
    "cordis.patch.yml",
    "LICENSE-pstack",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ../../scripts/gen-pstack-skills.mjs && tsc -p tsconfig.json",
    "gen": "node ../../scripts/gen-pstack-skills.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
