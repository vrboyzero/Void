{
  "name": "@void/void-soul",
  "version": "0.1.0",
  "description": "Void 灵魂档案：数据根、front matter 与身份校验。不含宿主装配。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./authority-service": {
      "types": "./lib/authority-service.d.ts",
      "default": "./lib/authority-service.js"
    },
    "./soul-library": {
      "types": "./lib/soul-library.d.ts",
      "default": "./lib/soul-library.js"
    },
    "./soul-service": {
      "types": "./lib/soul-service.d.ts",
      "default": "./lib/soul-service.js"
    },
    "./detail-view": {
      "types": "./lib/detail-view.d.ts",
      "default": "./lib/detail-view.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@void/void-entry": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@void/void-entry": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
