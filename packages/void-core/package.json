{
  "name": "@void/void-core",
  "version": "0.1.0",
  "description": "Void 配置合同与共享基础设施：七类分类、优先级、脱敏、校验（P0 配置合同骨架）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config-schema": "./lib/config-schema.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
